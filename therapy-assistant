// NEW: TherapyMind Import
// ========================

function triggerTherapyMindImport(axis) {
  if (!currentPatientId) { toast('⚠️ ابتدا یک بیمار را انتخاب کنید', 'warning'); return; }
  document.getElementById('tmImport' + (axis === 'axis1' ? 'Axis1' : 'Axis2')).click();
}

function handleDragOver(event, axis) {
  event.preventDefault();
  document.getElementById('dropzone-' + axis).classList.add('drag-over');
}

function handleDragLeave(event, axis) {
  document.getElementById('dropzone-' + axis).classList.remove('drag-over');
}

function handleDrop(event, axis) {
  event.preventDefault();
  document.getElementById('dropzone-' + axis).classList.remove('drag-over');
  const files = event.dataTransfer.files;
  if (files.length > 0) processTherapyMindFile(files[0], axis);
}

function handleTherapyMindFile(event, axis) {
  const file = event.target.files[0];
  if (!file) return;
  processTherapyMindFile(file, axis);
  event.target.value = ''; // Reset so same file can be re-imported
}

function processTherapyMindFile(file, axis) {
  if (!currentPatientId) { toast('⚠️ ابتدا یک بیمار را انتخاب کنید', 'warning'); return; }
  
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const payload = JSON.parse(e.target.result);
      
      // Validate this is a TherapyMind export
      if (!payload.__therapymind_export) {
        toast('❌ این فایل خروجی تِراپی‌مایند نیست', 'error');
        return;
      }
      
      if (payload.version !== "1.0") {
        toast('⚠️ نسخه فایل ناسازگار است', 'warning');
      }

      // Check if target axis matches
      const fileTarget = payload.target;
      if (fileTarget && fileTarget !== axis) {
        const axisNames = { axis1: 'محور ۱', axis2: 'محور ۲' };
        const confirmed = confirm(
          `این فایل برای ${axisNames[fileTarget] || fileTarget} طراحی شده، اما شما در حال وارد کردن به ${axisNames[axis]} هستید.\n\nآیا ادامه می‌دهید؟`
        );
        if (!confirmed) return;
      }

      // Import nodes from the payload
      const nodes = payload.nodes;
      if (!Array.isArray(nodes) || nodes.length === 0) {
        toast('❌ فایل خالی است یا ساختار نامعتبر دارد', 'error');
        return;
      }

      // Tag imported nodes with therapymind marker
      const taggedNodes = nodes.map(n => markTherapyMindNode(n));

      // Append to the target axis
      if (!Array.isArray(data.patients[currentPatientId][axis])) {
        data.patients[currentPatientId][axis] = [];
      }
      data.patients[currentPatientId][axis].push(...taggedNodes);
      
      save(); renderAll();
      
      const disorderName = getDisorderFaName(payload.disorder);
      toast(`✅ ${nodes.length} شاخه از تِراپی‌مایند (${disorderName}) با موفقیت وارد شد`, 'success');
    } catch (err) {
      console.error(err);
      toast('❌ خطا در پردازش فایل. فایل JSON معتبر نیست', 'error');
    }
  };
  reader.readAsText(file);
}

function markTherapyMindNode(node) {
  const tagged = { ...node, _therapymind: true };
  if (Array.isArray(node.children)) {
    tagged.children = node.children.map(markTherapyMindNode);
  }
  return tagged;
}

function getDisorderFaName(key) {
  const names = {
    depression: 'افسردگی', anxiety: 'اضطراب', bpd: 'شخصیت مرزی',
    ocd: 'وسواس', ptsd: 'PTSD', adhd: 'ADHD'
  };
  return names[key] || key || 'نامشخص';
}

