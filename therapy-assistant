function closeReport() { document.getElementById("reportModal").style.display = "none"; }

function generateReportSectionHTML(nodes) {
  if (!Array.isArray(nodes)) return '<p><i>خطا در بارگذاری اطلاعات.</i></p>';
  if (nodes.length === 0) return '<p><i>هنوز اطلاعاتی ثبت نشده است.</i></p>';
  let html = '<ul style="line-height: 1.8;">';
  nodes.forEach(node => {
    if (!node) return;
    const tmTag = node._therapymind ? ' <span class="therapymind-badge" style="font-size:10px;">🧠 تِراپی‌مایند</span>' : '';
    html += `<li style="margin-bottom: 15px;"><b>${node.title}</b>${tmTag}`;
    if (node.text) html += `<div style="margin: 5px 0 10px; padding: 10px; background: #f9fafb; border-right: 3px solid var(--primary); border-radius: 5px;">${node.text.replace(/\n/g, '<br>')}</div>`;
    if (node.children && Array.isArray(node.children) && node.children.length > 0) html += generateReportSectionHTML(node.children);
    html += '</li>';
  });
  html += '</ul>';
  return html;
}

function toggleAISection() { document.getElementById("aiSection").classList.toggle("hidden"); }
function sendCustomPrompt() {
  const input = document.getElementById("aiPromptInput");
  const text = input.value.trim();
  if (text) { sendToAI(text); input.value = ""; }
}

async function sendToAI(promptText) {
  const apiKey = document.getElementById("openRouterKey").value.trim();
  if (!apiKey) { alert("لطفا ابتدا کلید API شبکه OpenRouter را وارد کنید."); return; }
  const chatBox = document.getElementById("chatBox");
  chatBox.innerHTML += `<div class="message msg-user">${promptText}</div>`;
  chatBox.scrollTop = chatBox.scrollHeight;
  const therapySelect = document.getElementById("therapyMethod");
  const therapyName = therapySelect.selectedOptions.length > 0 ? therapySelect.selectedOptions[0].text : "نامشخص";
  const patientData = JSON.stringify(data.patients[currentPatientId]);
  const systemPrompt = `شما یک دستیار روان‌درمانگر متخصص هستید. اطلاعات شخص این مراجع: ${patientData}. توجه کن که درمانگر برای این مراجع از رویکرد درمانی "${therapyName}" استفاده می‌کند، لذا تحلیل‌ها و پیشنهاداتت حتماً در چارچوب مفاهیم و تکنیک‌های این رویکرد باشد.`;
  chatBox.innerHTML += `<div class="message msg-ai" id="loadingAi">در حال پردازش...</div>`;
  chatBox.scrollTop = chatBox.scrollHeight;
  try {
    const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
      method: "POST",
      headers: { "Authorization": `Bearer ${apiKey}`, "Content-Type": "application/json" },
      body: JSON.stringify({ "model": "openai/gpt-3.5-turbo", "messages": [{ "role": "system", "content": systemPrompt }, { "role": "user", "content": promptText }] })
    });
    const result = await response.json();
    document.getElementById("loadingAi").remove();
    if (result.choices && result.choices.length > 0) {
      chatBox.innerHTML += `<div class="message msg-ai">${result.choices[0].message.content.replace(/\n/g, '<br>')}</div>`;
    } else {
      chatBox.innerHTML += `<div class="message msg-ai" style="color:red;">خطا در دریافت پاسخ از سرور.</div>`;
    }
  } catch (error) {
    document.getElementById("loadingAi").remove();
    chatBox.innerHTML += `<div class="message msg-ai" style="color:red;">خطا در ارتباط با سرور OpenRouter.</div>`;
  }
  chatBox.scrollTop = chatBox.scrollHeight;
}

