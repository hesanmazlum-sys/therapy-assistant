function changeTherapy() {
  if (!currentPatientId) return;
  const method = document.getElementById("therapyMethod").value;
  if (confirm("توجه: تغییر رویکرد به منزله شروع دوباره جلسات است. آیا ادامه می‌دهید؟")) {
    data.patients[currentPatientId].therapyMethod = method;
    data.patients[currentPatientId].axis2 = defaultAxis(method);
    renderAll(); save();
  } else {
    document.getElementById("therapyMethod").value = data.patients[currentPatientId].therapyMethod || "existential";
  }
}

function addMainNode(axis) {
  if (!currentPatientId) return;
  const title = prompt("عنوان شاخه:");
  if (!title) return;
  data.patients[currentPatientId][axis].push({ title, text: "", children: [] });
  renderAll(); save();
}

function addChild(axis, path) {
  if (!currentPatientId) return;
  const node = getNode(axis, path);
  if (!node || !Array.isArray(node.children)) return;
  const title = prompt("عنوان زیرشاخه:");
  if (!title) return;
  node.children.push({ title, text: "", children: [] });
  renderAll(); save();
}

function deleteNode(axis, path) {
  if (!currentPatientId) return;
  const indexes = path.split(".").filter(x => x !== "").map(Number);
  const finalIndex = indexes.pop();
  let currentNodeArray = data.patients[currentPatientId][axis];
  for (let i = 0; i < indexes.length; i++) {
    const index = indexes[i];
    if (!currentNodeArray || !currentNodeArray[index] || !currentNodeArray[index].children) return;
    currentNodeArray = currentNodeArray[index].children;
  }
  if (currentNodeArray && currentNodeArray.length > finalIndex) {
    if (confirm("آیا از حذف این شاخه اطمینان دارید؟")) {
      currentNodeArray.splice(finalIndex, 1);
      renderAll(); save();
    }
  }
}

function getNode(axis, path) {
  const indexes = path.split(".").filter(x => x !== "").map(Number);
  let node = data.patients[currentPatientId][axis];
  for (let i = 0; i < indexes.length; i++) {
    const index = indexes[i];
    if (i === indexes.length - 1) { if (!node || !node[index]) return null; return node[index]; }
    else { if (!node || !node[index] || !node[index].children) return null; node = node[index].children; }
  }
  return null;
}

function editTitle(axis, path, value) {
  if (!currentPatientId) return;
  const node = getNode(axis, path);
  if (node) { node.title = value; save(); }
}

function editText(axis, path, value) {
  if (!currentPatientId) return;
  const node = getNode(axis, path);
  if (node) { node.text = value; save(); }
}

function renderAll() {
  renderTree("axis1", data.patients[currentPatientId].axis1, "axis1", "");
  renderTree("axis2", data.patients[currentPatientId].axis2, "axis2", "");
}

function renderTree(containerId, nodes, axis, pathPrefix) {
  const container = document.getElementById(containerId);
  if (!container) return;
  if (!Array.isArray(nodes)) nodes = [];
  container.innerHTML = nodes.length > 0
    ? generateTreeHTML(nodes, axis, pathPrefix)
    : '<p style="color: #888; font-style: italic; margin-top: 10px;">هنوز عنصری اضافه نشده است.</p>';
}

function generateTreeHTML(nodes, axis, pathPrefix) {
  let html = '<ul>';
  nodes.forEach((node, i) => {
    if (!node) return;
    const currentPath = pathPrefix + i + ".";
    const isExpanded = !node.collapsed;
    const toggleIcon = isExpanded ? "▼" : "◀";
    const nodeContentClass = isExpanded ? "" : "hidden";
    const tmBadge = node._therapymind 
      ? `<span class="therapymind-badge">🧠 تِراپی‌مایند</span>` 
      : '';

    html += `
      <li>
        <div class="title-row">
          <button class="toggle-btn" onclick="toggleNode(this, '${axis}', '${currentPath}')">${toggleIcon}</button>
          <input type="text" value="${(node.title || '').replace(/"/g, '&quot;')}" onchange="editTitle('${axis}', '${currentPath}', this.value)" placeholder="عنوان...">
          ${tmBadge}
          <div class="action-buttons">
            <button class="add-btn" onclick="addChild('${axis}', '${currentPath}')">+ زیرشاخه</button>
            <button class="delete-btn" onclick="deleteNode('${axis}', '${currentPath}')">حذف</button>
          </div>
        </div>
        <textarea placeholder="توضیحات و یادداشت‌ها..." onchange="editText('${axis}', '${currentPath}', this.value)">${node.text || ''}</textarea>
        <div class="node-content ${nodeContentClass}">
          ${node.children && node.children.length > 0 ? generateTreeHTML(node.children, axis, currentPath) : ''}
        </div>
      </li>
    `;
  });
  html += '</ul>';
  return html;
}

function toggleNode(button, axis, path) {
  const listItem = button.closest('li');
  const contentDiv = listItem.querySelector('.node-content');
  if (contentDiv) {
    contentDiv.classList.toggle('hidden');
    button.textContent = contentDiv.classList.contains('hidden') ? '◀' : '▼';
    const node = getNode(axis, path);
    if (node) {
      if (contentDiv.classList.contains('hidden')) node.collapsed = true;
      else delete node.collapsed;
      save();
    }
  }
}

function save() { localStorage.setItem("therapyDB", JSON.stringify(data)); }

